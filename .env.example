# Shared AI providers used by Docker Compose services.
# Copy to .env and replace blank values; never commit the resulting .env file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ADMIN_API_KEY=
BUDGET_USD=150
LLM_PRICING_JSON={"claude-opus-4-8":{"prompt_per_1m":2,"completion_per_1m":10},"glm-5.2":{"prompt_per_1m":6,"completion_per_1m":9},"gpt-5.5":{"prompt_per_1m":7,"completion_per_1m":14},"claude-opus-4-6":{"prompt_per_1m":8,"completion_per_1m":40},"claude-opus-4-7":{"prompt_per_1m":8,"completion_per_1m":40}}

# AgentRouter / LLM Configuration
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
LLM_MODEL=claude-opus-4-8

# Langfuse Cloud defaults to this host. Self-hosted installations should replace it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# GOA-014 Writing evaluation settings.
WRITING_MODEL=claude-sonnet-4-6
ANTHROPIC_TIMEOUT_SECONDS=25
WRITING_CACHE_VERSION=v1
RUN_WRITING_EVAL=0
