# Shared AI providers used by Docker Compose services.
# Copy to .env and replace blank values; never commit the resulting .env file.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ADMIN_API_KEY=
BUDGET_USD=150
LLM_PRICING_JSON={"claude-opus-4-8":{"prompt_per_1m":6,"completion_per_1m":30},"claude-opus-5":{"prompt_per_1m":2,"completion_per_1m":10},"gpt-5.6-sol":{"prompt_per_1m":6,"completion_per_1m":36}}

# AgentRouter / LLM Configuration
# Provider routing. Set GOA_LLM_BASE_URL, not ANTHROPIC_BASE_URL.
#
# docker compose resolves ${VAR} from the SHELL first and this file second, so a
# stray `ANTHROPIC_BASE_URL` exported in your environment silently overrides the
# project's setting -- and many tools export exactly that name. It happened: an
# AgentRouter key was posted to api.anthropic.com and every agent returned 401
# with nothing in the logs naming the host being called.
#
# GOA_LLM_BASE_URL is project-scoped, so nothing else exports it. Compose falls
# back to ANTHROPIC_BASE_URL when it is unset, so an un-migrated .env keeps
# working -- but only the scoped name is override-proof.
GOA_LLM_BASE_URL=https://agentrouter.org
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
LLM_MODEL=claude-opus-4-8

# Langfuse Cloud defaults to this host. Self-hosted installations should replace it.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# GOA-014 Writing evaluation settings.
# AgentRouter routes no channel for claude-sonnet-4-6; claude-opus-4-8 is the
# only served model, and GOA-093 consolidated Academic Task 1 vision onto it too.
WRITING_MODEL=claude-opus-4-8
# Vision model for the Academic Task 1 stimulus description (GOA-093).
VISION_MODEL=claude-opus-4-8
# claude-opus-4-8 via AgentRouter returns extended-thinking blocks; a single
# criterion agent regularly needs 40-90s. At 25s every evaluation lost agents
# to APITimeoutError.
ANTHROPIC_TIMEOUT_SECONDS=120
WRITING_CACHE_VERSION=v1
RUN_WRITING_EVAL=0
