{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://goa.local/schemas/speaking-dataset-manifest-v1.schema.json",
  "title": "Speaking evaluation dataset manifest v1",
  "description": "SPEAK-EVAL-004. Every speaking evaluation item is declared here before it can be used, and the declaration is what decides whether it may gate a release. The manifest exists because the alternative -- a folder of audio files and a spreadsheet -- makes 'is this item licensed', 'who banded it', and 'is this the same candidate as that item' unanswerable at the moment they matter, which is when a number is about to be published.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "splits",
    "items"
  ],
  "properties": {
    "manifest_version": {
      "const": "speaking-dataset-manifest/v1"
    },
    "description": {
      "type": "string"
    },
    "splits": {
      "description": "Declared splits and whether each one may gate a release. A split absent from here cannot be referenced by an item.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gating",
          "purpose"
        ],
        "properties": {
          "gating": {
            "type": "boolean",
            "description": "True when a metric computed over this split can block a release."
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "candidate_id",
        "series_id",
        "split",
        "source",
        "permission",
        "media",
        "labels",
        "retention"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "candidate_id": {
          "type": "string",
          "description": "The person who spoke. Two items from the same speaker share this, so a split assignment cannot put the same voice on both sides of a comparison.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "series_id": {
          "type": "string",
          "description": "The source series -- one recording, one video, one commissioned batch. Items from one series share editing, audio conditions and often the same examiner, so they leak across a split just as a candidate does.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "split": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "synthetic",
                "public_recording",
                "self_authored",
                "commissioned"
              ],
              "description": "synthetic is text with no audio and no human band; it can never gate."
            },
            "origin_url": {
              "type": "string"
            },
            "publisher": {
              "type": "string"
            },
            "retrieved_at": {
              "type": "string",
              "format": "date-time"
            },
            "governance_ref": {
              "type": "string",
              "description": "Ticket or document where the sourcing decision was recorded."
            }
          }
        },
        "permission": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "granted",
                "not_required",
                "pending",
                "denied",
                "unknown"
              ],
              "description": "unknown is the default and is deliberately not a synonym for not_required. An unreviewed item is not a permitted one."
            },
            "basis": {
              "type": "string",
              "description": "Why permission holds: the licence, the grant, or why none is needed."
            },
            "governance_ref": {
              "type": "string"
            },
            "reviewed_by": {
              "type": "string"
            },
            "reviewed_at": {
              "type": "string",
              "format": "date-time"
            }
          }
        },
        "media": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "storage",
            "restricted"
          ],
          "properties": {
            "storage": {
              "enum": [
                "none",
                "repo",
                "external"
              ],
              "description": "none means this item has no audio at all -- a transcript-only row."
            },
            "restricted": {
              "type": "boolean",
              "description": "True when the audio may not be redistributed. Restricted audio must never be stored in the repo."
            },
            "path": {
              "type": "string",
              "description": "Repo-relative path, required when storage is repo."
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "duration_s": {
              "type": "number",
              "minimum": 0
            },
            "format": {
              "type": "string"
            }
          }
        },
        "labels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "source",
            "validated"
          ],
          "properties": {
            "source": {
              "enum": [
                "official",
                "commissioned_double_rated",
                "model_generated",
                "none"
              ],
              "description": "model_generated means a model produced both the text and the band. Such an item measures agreement with a model, not accuracy, and can never gate."
            },
            "validated": {
              "type": "boolean",
              "description": "True only when a named human confirmed the band."
            },
            "overall_band": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 9,
              "multipleOf": 0.5
            },
            "criteria": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fluency_coherence": {
                  "$ref": "#/$defs/band"
                },
                "lexical_resource": {
                  "$ref": "#/$defs/band"
                },
                "grammatical_range": {
                  "$ref": "#/$defs/band"
                },
                "pronunciation": {
                  "$ref": "#/$defs/band"
                }
              }
            },
            "raters": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Named raters. Two are required for commissioned_double_rated."
            },
            "adjudicated": {
              "type": "boolean",
              "description": "True when two raters disagreed and a third resolved it."
            },
            "rating_ref": {
              "type": "string"
            }
          }
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy"
          ],
          "properties": {
            "policy": {
              "enum": [
                "indefinite",
                "delete_by_date",
                "delete_on_request"
              ]
            },
            "delete_after": {
              "type": "string",
              "format": "date"
            },
            "deletion_ref": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "inputs": {
          "type": "array",
          "description": "What this item can actually feed. `audio` means a recording exists; `transcript` means the words exist. An item provides one or both, and a lane may only consume items that provide what it needs. This replaces an earlier rule that required audio for any gating item -- written when every item was assumed to be a recording, and simply wrong for an officially banded transcript.",
          "items": {
            "enum": [
              "audio",
              "transcript"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transcript": {
          "type": "object",
          "additionalProperties": false,
          "description": "Where the transcript text lives. The text itself is NEVER committed when it is third-party copyright: the band score is a fact and can be recorded, the wording is expression and cannot.",
          "properties": {
            "storage": {
              "enum": [
                "none",
                "repo",
                "external"
              ]
            },
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "word_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "band": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 9,
      "multipleOf": 0.5
    }
  }
}
