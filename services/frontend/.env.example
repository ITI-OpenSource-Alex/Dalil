# GOA frontend — local development configuration.
#
#   cp .env.example .env.local
#
# Every value here matches the ports in docker-compose.yml at the repo root.
# Nothing in this file is secret; .env.local is gitignored so your copy stays
# local either way.

# --- Gateway -----------------------------------------------------------------
# Auth (login, register, refresh, logout) goes through the Gateway, which owns
# JWT validation, rate limiting and CORS.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Services called directly ------------------------------------------------
# These two bypass the Gateway today. That is a known defect, not the intended
# architecture — see BUG-046 and Wave 2 of the remediation plan. Once those calls
# move behind the Gateway, both of these variables disappear along with the
# internal API key below.
NEXT_PUBLIC_EXAM_API_URL=http://localhost:8085
NEXT_PUBLIC_WRITING_API_URL=http://localhost:8000

# --- Internal API key --------------------------------------------------------
# SECURITY DEFECT — BUG-046. Anything prefixed NEXT_PUBLIC_ is inlined into the
# client bundle and served to every visitor, so this key is public the moment the
# app is deployed. It is the same key that gates the internal endpoints, which
# means publishing it dissolves that boundary entirely.
#
# It is listed here only because the exam and writing calls above currently need
# it to function at all. Do not carry this pattern into new code, and rotate the
# key once those calls move behind the Gateway.
#
# The value below matches the development default in docker-compose.yml. Never
# put a production key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_INTERNAL_API_KEY=supersecret_internal_key_123
