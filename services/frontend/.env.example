# GOA frontend — local development configuration.
#
#   cp .env.example .env.local
#
# Everything the browser talks to now goes through the Gateway, so there is a
# single URL to configure. Nothing here is secret; .env.local is gitignored so
# your copy stays local either way.

# --- Gateway -----------------------------------------------------------------
# Auth, chat, exam and writing all route through here. The Gateway owns JWT
# validation, rate limiting, CORS, correlation IDs, and holds INTERNAL_API_KEY
# server-side so it never reaches the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Billing (GOA-039) -------------------------------------------------------
# Turns the Dalil Pro upgrade actions on. On by default: the billing endpoints
# come from the User service, which defaults to BILLING_MODE=demo (compose
# passes ${BILLING_MODE:-demo}), so a standard local stack serves them. Left at
# "false" the UI shows "Upgrades coming soon" and the whole checkout flow is
# invisible, which reads as a bug rather than as configuration.
#
# Set it to "false" only where the User service is genuinely running with
# billing off, so the button does not 404.
#
# Read at build time, not at runtime: NEXT_PUBLIC_* is inlined into the client
# bundle by `next build`, so changing it needs a rebuild (or a dev-server
# restart) before the page changes. Setting it in a deployed host's runtime
# environment does nothing.
#
# Not a security control: the paid-tier gate lives in the Gateway
# (middleware/subscription.go), not here. This only decides whether the UI
# offers an action that would currently fail.
#
# There is no payment-provider key of any kind, publishable or otherwise. The
# checkout page is served by this app and the payment is simulated.
NEXT_PUBLIC_BILLING_ENABLED=true

# --- Notes -------------------------------------------------------------------
# NEXT_PUBLIC_EXAM_API_URL and NEXT_PUBLIC_WRITING_API_URL are gone. Those calls
# went straight to the services on :8085 and :8000 and had to carry
# NEXT_PUBLIC_INTERNAL_API_KEY, which the NEXT_PUBLIC_ prefix inlines into the
# client bundle — publishing the key that gates the internal endpoints to every
# visitor (BUG-046). Routing through the Gateway removed the need for all three.
#
# NEXT_PUBLIC_SPEAKING_API_URL is gone too (GOA-132). It pointed the browser at
# the Speaking service on :8082 for session history, share links, and the
# WebSocket -- all with no JWT check, no rate limit and no correlation ID, and
# with userId taken from the query string rather than the token. Those routes
# now live at /api/speaking/* behind the Gateway, and the socket at
# /api/speaking/ws, both derived from NEXT_PUBLIC_API_URL above.
