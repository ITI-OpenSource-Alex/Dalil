# GOA frontend — local development configuration.
#
#   cp .env.example .env.local
#
# Everything the browser talks to now goes through the Gateway, so there is a
# single URL to configure. Nothing here is secret; .env.local is gitignored so
# your copy stays local either way.

# --- Gateway -----------------------------------------------------------------
# Auth, chat, exam and writing all route through here. The Gateway owns JWT
# validation, rate limiting, CORS, correlation IDs, and holds INTERNAL_API_KEY
# server-side so it never reaches the browser.
NEXT_PUBLIC_API_URL=http://localhost:8080

# --- Notes -------------------------------------------------------------------
# NEXT_PUBLIC_EXAM_API_URL and NEXT_PUBLIC_WRITING_API_URL are gone. Those calls
# went straight to the services on :8085 and :8000 and had to carry
# NEXT_PUBLIC_INTERNAL_API_KEY, which the NEXT_PUBLIC_ prefix inlines into the
# client bundle — publishing the key that gates the internal endpoints to every
# visitor (BUG-046). Routing through the Gateway removed the need for all three.
#
# The Speaking WebSocket is the one client call that still bypasses the Gateway,
# because the Gateway has no WS proxy yet (GOA-094). Orchestration hands the
# browser that URL directly via PUBLIC_SPEAKING_WS_URL in docker-compose.yml, so
# there is nothing to configure here.
