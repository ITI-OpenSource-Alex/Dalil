# Gateway Configuration
PORT=8080
DATABASE_URL=postgres://goa:goa_pass@postgres:5432/user_db?sslmode=disable
REDIS_URL=redis://redis-gateway:6379/0
WRITING_SERVICE_URL=http://writing:8000
EXAM_SERVICE_URL=http://exam:8085
USER_SERVICE_URL=http://user-service:8081
INTERNAL_API_KEY=supersecret_internal_key_123
SUBSCRIPTION_UPGRADE_URL=http://localhost:3000/upgrade
SUBSCRIPTION_CACHE_TTL=5m
JWT_SECRET=supersecret_dev_key
VERSION=0.1.0
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=720h
READ_TIMEOUT=5s
WRITE_TIMEOUT=10s
SHUTDOWN_TIMEOUT=10s
SECURE_COOKIES=false
# Observability (GOA-001 Requirement)
OTEL_SERVICE_NAME=gateway
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com
