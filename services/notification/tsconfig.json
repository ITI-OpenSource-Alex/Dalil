{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    // rootDir is the repo root, not ./src, because src/events.ts and
    // src/templates.ts import the shared event contract from
    // packages/contracts/ts. With rootDir at ./src, tsc fails outright:
    //   TS6059: File '.../packages/contracts/ts/index.ts' is not under rootDir
    // so `npm run build` could not run at all. The unit tests still passed,
    // because ts-jest resolves modules independently of the compiler — which is
    // exactly how this service reached "9/9 passing" with a broken build.
    //
    // Consequence: emitted paths mirror the repo layout, so the entry point is
    // dist/services/notification/src/handler.js. The Dockerfile CMD reflects that.
    "rootDir": "../..",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "../../packages/contracts/ts/index.ts"]
}
