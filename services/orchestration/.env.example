PORT=8083
DATABASE_URL=postgresql://goa:goa_pass@postgres:5432/orchestration_db
REDIS_URL=redis://redis-cache:6379/1
ANTHROPIC_API_KEY=
INTERNAL_API_KEY=supersecret_internal_key_123
OTEL_SERVICE_NAME=orchestration
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
RAG_SERVICE_URL=http://rag:8084
SPEAKING_SERVICE_URL=http://speaking:8082
WRITING_SERVICE_URL=http://writing:8000
# Was missing from this file while config.py has defaulted it since GOA-061.
EXAM_SERVICE_URL=http://exam:8085

# Long-term conversation memory (GOA-038).
# MEMORY_ENABLED=false disables the sweep, the fact load and the prompt
# injection; the delete endpoint stays live regardless, because a privacy
# control that a flag can switch off is not a privacy control.
MEMORY_ENABLED=true
MEMORY_IDLE_MINUTES=30
MEMORY_SWEEP_INTERVAL_SECONDS=300
MEMORY_SWEEP_BATCH_MAX=20
MEMORY_FACT_TTL_DAYS=30
MEMORY_MIN_TURNS=4
MEMORY_LOAD_TIMEOUT_MS=250
MEMORY_CACHE_TTL_SECONDS=300