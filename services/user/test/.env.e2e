# E2E test environment — mirrors docker-compose.yml values for user-service.
# This file is loaded by test/setup-e2e.ts before Jest boots the Nest application.
# It must NEVER be committed with real secrets.

# ── PostgreSQL (matches docker-compose postgres service) ──────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=goa
DB_PASSWORD=goa_pass
DB_NAME=user_db

# ── Application ───────────────────────────────────────────────────────────────
PORT=8081
INTERNAL_API_KEY=supersecret_internal_key_123

# ── AWS / LocalStack (matches docker-compose user-service environment) ────────
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/user-events
SQS_PRODUCER_NAME=user-events
