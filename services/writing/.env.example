DATABASE_URL=postgresql://goa:goa_pass@localhost:5432/writing_db
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localhost:4566
S3_BUCKET=goa-writing-files
CV_UPLOADED_QUEUE_URL=http://localhost:4566/000000000000/goa-cv-uploaded
CV_PROCESSED_QUEUE_URL=http://localhost:4566/000000000000/goa-cv-processed
CV_PROCESSOR_QUEUE_URL=http://localhost:4566/000000000000/goa-cv-processing

OPENAI_API_KEY=sk-proj-a1B2c3D4e5F6g7H8i9J0k1L2m3N4o5P6q7R8s9T0u1V2w3X4

OTEL_SERVICE_NAME=writing-service

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

ANTHROPIC_API_KEY=
WRITING_MODEL=claude-sonnet-4-6
CV_EXTRACTION_MODEL=claude-haiku-4-5-20251001
# GOA-030: was 25. The root .env.example has warned since GOA-014 that a single
# criterion agent regularly needs 40-90s, and that at 25s "every evaluation lost
# agents to APITimeoutError" -- but this service-local copy, which is the one a
# writing developer actually copies, still carried the value the warning is
# about. Measured through the Gateway on 2026-08-11: a 180-word Task 2 essay
# returned "1 of 4 writing agents failed: Request timed out".
ANTHROPIC_TIMEOUT_SECONDS=120
WRITING_SCORE_MAX_TOKENS=8000
WRITING_FEEDBACK_MAX_TOKENS=8000
WRITING_FEEDBACK_MODEL=gpt-5.6-sol
WRITING_SELECTIVE_ENSEMBLE=true
WRITING_MAX_ENSEMBLE_CRITERIA=1
WRITING_CACHE_VERSION=v2
RUN_WRITING_EVAL=0
